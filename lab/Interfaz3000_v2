nextSample = 0
autoStopOuter = False
wasCalledBack = False

def picoScope(frec1, frec2, inc, tInc):
    global nextSample, autoStopOuter, wasCalledBack, ruta

    status = {}
    chandle = ctypes.c_int16()

    status["openunit"] = ps.ps3000aOpenUnit(ctypes.byref(chandle), None)
    try:
        assert_pico_ok(status["openunit"])
    except:
        powerStatus = status["openunit"]

        if powerStatus == 282:
            status["changePowerSource"] = ps.ps3000aChangePowerSource(chandle, 282)
        elif powerStatus == 286:
            status["changePowerSource"] = ps.ps3000aChangePowerSource(chandle, 286)
        else:
            raise

        assert_pico_ok(status["changePowerSource"])

    # =========================
    # Generador interno
    # =========================
    wavetype = ctypes.c_int16(0)     # seno
    sweeptype = ctypes.c_int32(0)    # up
    triggertype = ctypes.c_int32(0)
    triggersource = ctypes.c_int32(0)
    extInThreshold = ctypes.c_int16(0)

    status["SetSigGenBuiltIn"] = ps.ps3000aSetSigGenBuiltIn(
        chandle,
        0,
        2000000,
        wavetype,
        frec1,
        frec2,
        inc,
        tInc,
        sweeptype,
        0,
        0,
        0,
        triggertype,
        triggersource,
        extInThreshold
    )
    assert_pico_ok(status["SetSigGenBuiltIn"])

    # =========================
    # Canales
    # =========================
    enable = 1
    analogue_offset = 0.0

    # Canal A: referencia / entrada
    channel_range_A = ps.PS3000A_RANGE['PS3000A_2V']

    # Canal B: respuesta / sensor
    # Prueba 200 mV; si satura, sube a 500 mV o 1 V
    channel_range_B = ps.PS3000A_RANGE['PS3000A_200MV']

    status["setChA"] = ps.ps3000aSetChannel(
        chandle,
        ps.PS3000A_CHANNEL['PS3000A_CHANNEL_A'],
        enable,
        ps.PS3000A_COUPLING['PS3000A_DC'],
        channel_range_A,
        analogue_offset
    )
    assert_pico_ok(status["setChA"])

    status["setChB"] = ps.ps3000aSetChannel(
        chandle,
        ps.PS3000A_CHANNEL['PS3000A_CHANNEL_B'],
        enable,
        ps.PS3000A_COUPLING['PS3000A_DC'],
        channel_range_B,
        analogue_offset
    )
    assert_pico_ok(status["setChB"])

    # =========================
    # Muestreo
    # =========================
    # Antes: 6*frec2  -> muy bajo
    # Ahora: 20*frec2 -> mejor resolución temporal
    FrecuenciaMuestreo = int(20 * frec2)

    # periodo de muestreo en microsegundos
    periodoMuestra = int((1 / FrecuenciaMuestreo) * 1_000_000)
    if periodoMuestra < 1:
        periodoMuestra = 1

    # Frecuencias del barrido para este bloque
    frecuencias_barrido = np.arange(frec1, frec2, inc, dtype=float)

    # si por redondeo el arreglo queda vacío, salir
    if len(frecuencias_barrido) == 0:
        status["stop"] = ps.ps3000aStop(chandle)
        status["close"] = ps.ps3000aCloseUnit(chandle)
        return

    muestras_por_frecuencia = int(round(tInc * FrecuenciaMuestreo))
    totalSamples = len(frecuencias_barrido) * muestras_por_frecuencia

    sizeOfOneBuffer = totalSamples
    numBuffersToCapture = 1
    memory_segment = 0

    bufferAMax = np.zeros(shape=sizeOfOneBuffer, dtype=np.int16)
    bufferBMax = np.zeros(shape=sizeOfOneBuffer, dtype=np.int16)

    status["setDataBuffersA"] = ps.ps3000aSetDataBuffers(
        chandle,
        ps.PS3000A_CHANNEL['PS3000A_CHANNEL_A'],
        bufferAMax.ctypes.data_as(ctypes.POINTER(ctypes.c_int16)),
        None,
        sizeOfOneBuffer,
        memory_segment,
        ps.PS3000A_RATIO_MODE['PS3000A_RATIO_MODE_NONE']
    )
    assert_pico_ok(status["setDataBuffersA"])

    status["setDataBuffersB"] = ps.ps3000aSetDataBuffers(
        chandle,
        ps.PS3000A_CHANNEL['PS3000A_CHANNEL_B'],
        bufferBMax.ctypes.data_as(ctypes.POINTER(ctypes.c_int16)),
        None,
        sizeOfOneBuffer,
        memory_segment,
        ps.PS3000A_RATIO_MODE['PS3000A_RATIO_MODE_NONE']
    )
    assert_pico_ok(status["setDataBuffersB"])

    sampleInterval = ctypes.c_int32(periodoMuestra)
    sampleUnits = ps.PS3000A_TIME_UNITS['PS3000A_US']
    maxPreTriggerSamples = 0
    autoStopOn = 1
    downsampleRatio = 1

    status["runStreaming"] = ps.ps3000aRunStreaming(
        chandle,
        ctypes.byref(sampleInterval),
        sampleUnits,
        maxPreTriggerSamples,
        totalSamples,
        autoStopOn,
        downsampleRatio,
        ps.PS3000A_RATIO_MODE['PS3000A_RATIO_MODE_NONE'],
        sizeOfOneBuffer
    )
    assert_pico_ok(status["runStreaming"])

    bufferCompleteA = np.zeros(shape=totalSamples, dtype=np.int16)
    bufferCompleteB = np.zeros(shape=totalSamples, dtype=np.int16)

    def streaming_callback(handle, noOfSamples, startIndex, overflow, triggerAt, triggered, autoStop, param):
        global nextSample, autoStopOuter, wasCalledBack
        wasCalledBack = True
        destEnd = nextSample + noOfSamples
        sourceEnd = startIndex + noOfSamples

        if destEnd > totalSamples:
            destEnd = totalSamples
            sourceEnd = startIndex + (destEnd - nextSample)

        bufferCompleteA[nextSample:destEnd] = bufferAMax[startIndex:sourceEnd]
        bufferCompleteB[nextSample:destEnd] = bufferBMax[startIndex:sourceEnd]
        nextSample += (destEnd - nextSample)

        if autoStop:
            autoStopOuter = True

    cFuncPtr = ps.StreamingReadyType(streaming_callback)

    while nextSample < totalSamples and not autoStopOuter:
        wasCalledBack = False
        status["getStreamingLatestValues"] = ps.ps3000aGetStreamingLatestValues(chandle, cFuncPtr, None)
        if not wasCalledBack:
            time.sleep(0.01)

    maxADC = ctypes.c_int16()
    status["maximumValue"] = ps.ps3000aMaximumValue(chandle, ctypes.byref(maxADC))
    assert_pico_ok(status["maximumValue"])

    adc2mVChAMax = adc2mV(bufferCompleteA, channel_range_A, maxADC)
    adc2mVChBMax = adc2mV(bufferCompleteB, channel_range_B, maxADC)

    status["stop"] = ps.ps3000aStop(chandle)
    assert_pico_ok(status["stop"])

    status["close"] = ps.ps3000aCloseUnit(chandle)
    assert_pico_ok(status["close"])

    nextSample = 0
    autoStopOuter = False
    wasCalledBack = False

    # =========================
    # Procesamiento espectral mejorado
    # =========================
    amplitudesA = []
    amplitudesB = []

    N = muestras_por_frecuencia
    dt = 1.0 / FrecuenciaMuestreo
    freqs_fft = np.fft.rfftfreq(N, d=dt)
    ventana_hann = np.hanning(N)

    for j, f_actual in enumerate(frecuencias_barrido):
        ini = j * N
        fin = ini + N

        segA = np.array(adc2mVChAMax[ini:fin]).astype(float)
        segB = np.array(adc2mVChBMax[ini:fin]).astype(float)

        if len(segA) < N or len(segB) < N:
            break

        # 3) quitar media
        segA = segA - np.mean(segA)
        segB = segB - np.mean(segB)

        # 5) ventana de Hann
        segA = segA * ventana_hann
        segB = segB * ventana_hann

        YA = np.fft.rfft(segA)
        YB = np.fft.rfft(segB)

        # 2) amplitud en la frecuencia excitada
        k = np.argmin(np.abs(freqs_fft - f_actual))

        ampA = np.abs(YA[k])
        ampB = np.abs(YB[k])

        amplitudesA.append(ampA)
        amplitudesB.append(ampB)

    # =========================
    # Guardado
    # =========================
    with open(ruta, "a") as new_file:
        for f_actual, ampA, ampB in zip(frecuencias_barrido, amplitudesA, amplitudesB):
            if ampA > 1e-15:
                C = ampB / ampA
            else:
                C = 0.0

            new_file.write(f"{f_actual}\t{C}\n")

