def esperar_evento():
    global evento, canvas,toolbar
    ev1 = evento.get()
    if ev1 == 1:
        #print("Evento aún no ha ocurrido, esperando...")
        ventana.after(10000, esperar_evento)  # Espera 10 segundos y vuelve a comprobar
    else:
        #print("Evento ha ocurrido")
        ciclos = (fo-fi) // 100
        residuo = (fo - fi) % 100
        fi1 = fi
        fo1 = fi1 + 100

        if ciclos >= 1:
            for n in range(ciclos):
                picoScope(fi1,fo1,incremento,tiempoInc)
                fi1 = fo1
                fo1 = fo1 + 100 
            
        if residuo != 0:
            fi1 = fo - residuo
            #print(f"Llamando a picoScope con fi1={fi1}, fo={fo}")
            picoScope(fi1,fo,incremento,tiempoInc)
    
    fig = Figure(figsize=(5, 5), dpi=100)
    ax = fig.add_subplot(111)

    # Cargar y graficar datos desde el archivo
    x, y = np.loadtxt(ruta, skiprows=0, usecols=[0,1], unpack= True)
    ax.plot(x, y, marker='o', linestyle='-')
    ax.set_title("Sistema de medida",fontdict={'fontsize':16})
    ax.set_xlabel("Frecuencia (Hz)",fontdict={'fontsize':14})
    ax.set_ylabel("Amplitud (U. Arb.)",fontdict={'fontsize':14})

    # Crear lienzo de Matplotlib en la ventana
    if canvas is not None:
        canvas.get_tk_widget().destroy()
        toolbar.destroy()
    canvas = FigureCanvasTkAgg(fig, master=ventanaGrafica)
    canvas.draw()
    canvas.get_tk_widget().pack(padx=50,pady=30,anchor='w')
    toolbar = NavigationToolbar2Tk(canvas,ventanaGrafica)
    toolbar.update()
    toolbar.pack()


